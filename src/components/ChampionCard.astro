---
import { Image } from 'astro:assets';

const { data, index = 0 } = Astro.props;

const imageUrl = `https://ddragon.leagueoflegends.com/cdn/img/champion/splash/${data.id}_0.jpg`;
const loadingStrategy = index < 16 ? 'eager' : 'lazy';
---

<a
  href={`/champions/${data.name}`}
  class="relative overflow-hidden rounded-lg border border-zinc-900"
>
  <p
    class="absolute bottom-1 left-1 text-white bg-zinc-900/80 border border-zinc-700 rounded-md px-2 py-0.5 z-10"
  >
    {data.name}
  </p>
  <Image
    src={imageUrl}
    alt={data.name + ' splash art'}
    height={720}
    width={540}
    class="hover:scale-105 transition-all duration-300 grayscale-75 hover:grayscale-0"
    loading={loadingStrategy}
  />
</a>
