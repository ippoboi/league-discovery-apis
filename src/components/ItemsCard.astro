---
import { Image } from 'astro:assets';

const { data, index = 0 } = Astro.props;

const imageUrl = `https://ddragon.leagueoflegends.com/cdn/15.7.1/img/item/${data.image.full}`;
---

<a href={`/items/${data.id}`} class="relative overflow-hidden rounded-lg border border-zinc-900">
  <Image
    src={imageUrl}
    alt={data.name + ' splash art'}
    height={1000}
    width={1000}
    class="lg:hover:scale-105 lg:transition-all lg:duration-300 lg:grayscale-75 lg:hover:grayscale-0"
  />
</a>
