---
import { Image } from 'astro:assets';

const { data } = Astro.props;

const imageUrl = `https://ddragon.leagueoflegends.com/cdn/15.7.1/img/item/${data.image.full}`;
---

<a href={`/items/${data.name}`} class="relative overflow-hidden rounded-lg border border-zinc-900">
  <!-- <p
    class="absolute bottom-1 left-1 text-white bg-zinc-900/80 border border-zinc-700 rounded-md px-2 py-0.5 z-10"
  >
    {data.name}
  </p> -->
  <Image
    src={imageUrl}
    alt={data.name + ' splash art'}
    height={1000}
    width={1000}
    class="hover:scale-105 transition-all duration-300 grayscale-75 hover:grayscale-0"
  />
</a>
