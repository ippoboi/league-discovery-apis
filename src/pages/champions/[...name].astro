---
import { Image } from 'astro:assets';
import MarkdownPostLayout from '../../layouts/MarkdownPostLayout.astro';
import { getChampionData } from '../../utils/championUtils';

export async function getStaticPaths() {
  const allChampionsData = await getChampionData();
  return Object.values(allChampionsData.data).map((champion: any) => ({
    params: { name: champion.id },
    props: { champion },
  }));
}

const { champion } = Astro.props;
const imageUrl = `https://ddragon.leagueoflegends.com/cdn/img/champion/splash/${champion.id}_0.jpg`;
---

<MarkdownPostLayout frontmatter={champion}>
  <Image src={imageUrl} alt={champion.name} width={1920} height={1080} />
  <div class="flex gap-2 items-baseline">
    <h1 class="text-2xl font-bold">{champion.name}</h1>
    <p class="text-gray-500">{champion.title}</p>
  </div>
  <p>{champion.lore}</p>
</MarkdownPostLayout>
