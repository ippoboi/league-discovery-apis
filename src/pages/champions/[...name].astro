---
import { Image } from 'astro:assets';
import MarkdownPostLayout from '../../layouts/MarkdownPostLayout.astro';
import { getChampionData, getChampionDataByChampionName } from '../../utils/championUtils';
import SkinCarousel from '../../components/SkinCarousel';

export async function getStaticPaths() {
  const allChampionsData = await getChampionData();

  // Return only params, not props
  return Object.values(allChampionsData.data).map((champion: any) => ({
    params: { name: champion.id },
  }));
}

// Get champion name from URL params
const championName = Astro.params.name;

// Fetch specific champion data
const championData = await getChampionDataByChampionName(championName);
// The API returns data nested under the champion's name, so we need to extract it
const champion = championData.data[championName];

const imageUrl = `https://ddragon.leagueoflegends.com/cdn/img/champion/splash/${champion.id}_0.jpg`;
const skins = champion.skins.map((skin: any) => ({
  splash: `https://ddragon.leagueoflegends.com/cdn/img/champion/splash/${champion.id}_${skin.num}.jpg`,
  name: skin.name,
}));
---

<MarkdownPostLayout frontmatter={champion}>
  <SkinCarousel client:visible skins={skins} champion={champion} />

  <p>{champion.lore}</p>
</MarkdownPostLayout>
