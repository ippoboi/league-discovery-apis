---
import { Image } from 'astro:assets';
import MarkdownPostLayout from '../../layouts/MarkdownPostLayout.astro';
import { getItemData } from '../../utils/itemsUtils';

export async function getStaticPaths() {
  const allItemsData = await getItemData();
  return Object.values(allItemsData.data).map((item: any) => ({
    params: { name: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const imageUrl = `https://ddragon.leagueoflegends.com/cdn/15.7.1/img/item/${item.image.full}`;
---

<MarkdownPostLayout frontmatter={item}>
  <Image src={imageUrl} alt={item.name} width={1920} height={1080} />
  <div class="flex gap-2 items-baseline">
    <h1 class="text-2xl font-bold">{item.name}</h1>
    <p class="text-gray-500">{item.description}</p>
  </div>
  <p>{item.description}</p>
</MarkdownPostLayout>
